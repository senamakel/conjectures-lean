  rcases lt_or_ge q (2 ^ 27) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_12 q (by omega) h
  rcases lt_or_ge q (2 ^ 100) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_13 q (by omega) h
  exact LLS.Check.checkChunk_sound chunk2_ok_14 q h hq

