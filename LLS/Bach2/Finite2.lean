set_option exponentiation.threshold 4096

namespace LLS

theorem good2_range (q : ℕ) (hq3 : 3 ≤ q) (hq : q < 2 ^ 2500) : Good2 q := by
  rcases lt_or_ge q (2 ^ 17) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_0 q (by omega) h
  rcases lt_or_ge q (2 ^ 18) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_1 q (by omega) h
  rcases lt_or_ge q (2 ^ 19) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_2 q (by omega) h
  rcases lt_or_ge q (2 ^ 20) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_3 q (by omega) h
  rcases lt_or_ge q (2 ^ 21) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_4 q (by omega) h
  rcases lt_or_ge q (3145728) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_5 q (by omega) h
  rcases lt_or_ge q (2 ^ 22) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_6 q (by omega) h
  rcases lt_or_ge q (6291456) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_7 q (by omega) h
  rcases lt_or_ge q (2 ^ 23) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_8 q (by omega) h
  rcases lt_or_ge q (2 ^ 24) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_9 q (by omega) h
  rcases lt_or_ge q (2 ^ 25) with h | h
  · exact LLS.Check.checkChunk_sound chunk2_ok_10 q (by omega) h
  rcases lt_or_ge q (2 ^ 26) with h | h
