theorem equal_m19 {a c p q : ℕ}
    (ha : 3 ≤ a) (hc : 5 ≤ c) (hac : a ≤ c) (hca : c ≤ 19*a)
    (hf : (a + 19*c)^2 = p*((a+1)*(19*c+1)))
    (hg : (c + 19*a)^2 = q*((c+1)*(19*a+1))) : p = q := by
  obtain ⟨hq, hqhi, hqp, hphi⟩ := quotient_bounds (by decide : 5 ≤ 19) ha hc hac hca hf hg
  by_contra hn
  have hp : q < p := lt_of_le_of_ne hqp (Ne.symm hn)
  obtain ⟨mods,hmods⟩ := rows_19 q hq hqhi
  have hpMem : p ∈ List.range' (q+1) (19*19+2-q) :=
    List.mem_range'_1.mpr ⟨by omega, by omega⟩
  have hcheck := List.all_eq_true.mp hmods p hpMem
  simp only [Bool.and_eq_true] at hcheck
  exact excludes_sound (of_decide_eq_true hcheck.1) hcheck.2 (a : ℤ)
    (eliminant_zero (c := (c : ℤ)) (by exact_mod_cast hf) (by exact_mod_cast hg))

