theorem no_cubic_root {A B C D a r : ℤ}
    (hr : 0 < r)
    (hc : ∀ z : ℤ, 0 ≤ z → z < r →
      ¬ (((A*z+B)*z+C)*z+D ≡ 0 [ZMOD r])) :
    ((A*a+B)*a+C)*a+D ≠ 0 := by
  intro h
  let z := a % r
  have hz : a ≡ z [ZMOD r] := (Int.mod_modEq _ _).symm
  have h₁ := (hz.mul_left A).add_right B
  have h₂ := (h₁.mul hz).add_right C
  have h₃ := (h₂.mul hz).add_right D
  rw [h] at h₃
  exact hc z (Int.emod_nonneg _ hr.ne') (Int.emod_lt_of_pos _ hr) h₃.symm

theorem exceptional60 {a : ℤ} (ha : 3 ≤ a) : eliminant 17 60 4 a ≠ 0 := by
  have hn : ((69639025*a-13838255)*a-1379281)*a-26929 ≠ 0 := by
    apply no_cubic_root (r := 13) (by decide)
    intro z h₀ h₁
    interval_cases z <;> decide
  rw [show eliminant 17 60 4 a =
      64*(a-1)*(((69639025*a-13838255)*a-1379281)*a-26929) by
    unfold eliminant l v b d
    ring]
  exact mul_ne_zero (mul_ne_zero (by decide) (by omega)) hn

theorem exceptional264 {a : ℤ} (ha : 3 ≤ a) : eliminant 17 264 4 a ≠ 0 := by
  have hn : ((3806401*a-267352319)*a+60809855)*a+3468863 ≠ 0 := by
    apply no_cubic_root (r := 19) (by decide)
    intro z h₀ h₁
    interval_cases z <;> decide
  rw [show eliminant 17 264 4 a =
      16*(a-1)*(((3806401*a-267352319)*a+60809855)*a+3468863) by
    unfold eliminant l v b d
    ring]
  exact mul_ne_zero (mul_ne_zero (by decide) (by omega)) hn

theorem equal_q4_m17 {a c p : ℕ}
    (ha : 3 ≤ a) (hc : 5 ≤ c) (hac : a ≤ c) (hca : c ≤ 17*a)
    (hf : (a+17*c)^2 = p*((a+1)*(17*c+1)))
    (hg : (c+17*a)^2 = 4*((c+1)*(17*a+1))) : p = 4 := by
  obtain ⟨_, _, hle, hhi⟩ := quotient_bounds (by decide : 5 ≤ 17) ha hc hac hca hf hg
  by_contra hne
  have hroot : eliminant 17 p 4 a = 0 :=
    eliminant_zero (c := (c : ℤ)) (by exact_mod_cast hf) (by exact_mod_cast hg)
  have ha' : (3 : ℤ) ≤ a := by exact_mod_cast ha
  by_cases h60 : p = 60
  · subst p
    exact exceptional60 ha' hroot
  by_cases h264 : p = 264
  · subst p
    exact exceptional264 ha' hroot
  obtain ⟨mods, hmods⟩ := row17
  have hpMem : p ∈ List.range' 5 287 := List.mem_range'_1.mpr ⟨by omega, by omega⟩
  have hcheck := List.all_eq_true.mp hmods p hpMem
  simp only [h60, h264, or_self, if_false, Bool.and_eq_true] at hcheck
  exact excludes_sound (of_decide_eq_true hcheck.1) hcheck.2 (a : ℤ) hroot

