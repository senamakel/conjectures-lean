import Mathlib

/-!
# The Flint Hills and Cookson Hills series: the statements

`FlintHillsStatement` and `CooksonHillsStatement` are the statements of the theorems
`FlintCooksonHills.flint_hills_series_converges` and
`FlintCooksonHills.cookson_hills_series_converges` of
`FormalConjectures/Wikipedia/FlintCooksonHills.lean` in
<https://github.com/google-deepmind/formal-conjectures> (Apache-2.0, commit `9097e2f`), copied
word for word. Both are tagged `@[category research open, question, AMS 40]` there.

Do not edit this file to make a proof go through.
-/

namespace FlintCooksonHills

/--
The Flint Hills series summing $csc(n)^2 / n^3$ from $n=1$ to $\infty$ converges.
(Note that we 0-index the series below.)
-/
def FlintHillsStatement : Prop :=
    Summable (fun n : ℕ =>
      1 / ((((n + 1) : ℝ)^3) * (Real.sin (n + 1)^2)))

/--
The Cookson Hills series summing $sec(n)^2 / n^3$ from $n=1$ to $\infty$ converges.
-/
def CooksonHillsStatement : Prop :=
    Summable (fun n : ℕ =>
      1 / ((((n + 1) : ℝ)^3) * (Real.cos (n + 1)^2)))

end FlintCooksonHills
