theorem goodP_rough (q : ℕ) (h1 : 3000 ≤ q) (h2 : q < 4096) : GoodP 1 q := by
  rcases lt_or_ge q 3375 with h | h1
  · exact good_0 q h1 h
  rcases lt_or_ge q 3585 with h | h1
  · exact good_1 q h1 h
  rcases lt_or_ge q 3809 with h | h1
  · exact good_2 q h1 h
  exact good_3 q h1 h2

end LLS.IvR

