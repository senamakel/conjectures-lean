import LLS.Numerics.Prime

/-!
# Certified intervals, `c = 1`: every `3000 ≤ q < 4096` is `GoodP 1`

Generated by `scripts/emit_rough.py`; 4 intervals. (`LLS.IvP.goodP_range` covers `q ≥ 2^12`.)
-/

set_option exponentiation.threshold 1024

namespace LLS.IvR
open LLS

theorem good_0 (q : ℕ) (h1 : 3000 ≤ q) (h2 : q < 3375) : GoodP 1 q :=
  goodP_of_data q 3000 3375 739 751 64 (8 : ℝ) (8 : ℝ) 384 384 h1 h2
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num [Side1OK, iEs])
    (by norm_num [Phi1Lo, iK₁, iK₂, ik₂, iEs])

theorem good_1 (q : ℕ) (h1 : 3375 ≤ q) (h2 : q < 3585) : GoodP 1 q :=
  goodP_of_data q 3375 3585 750 756 65 (4031 / 500 : ℝ) (8063 / 1000 : ℝ) 385 386 h1 h2
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num [Side1OK, iEs])
    (by norm_num [Phi1Lo, iK₁, iK₂, ik₂, iEs])

theorem good_2 (q : ℕ) (h1 : 3585 ≤ q) (h2 : q < 3809) : GoodP 1 q :=
  goodP_of_data q 3585 3809 755 762 66 (2031 / 250 : ℝ) (65 / 8 : ℝ) 386 387 h1 h2
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
