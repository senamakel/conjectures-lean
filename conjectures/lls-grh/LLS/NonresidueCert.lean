import LLS.Numerics.Interval

/-!
# Certificates for the least quadratic non-residue, `5 ≤ q < 2^12`

For each `q` with `5 ≤ q < 4096` the list `smallCert` gives `(n, k)` with `0 < n < q`,
`2^k ≤ q^16` (so `log q ≥ (k/16) log 2`), `n ≤ ((k/16) · 0.6931471803)²` and
`n^((q−1)/2) ≢ 1 (mod q)`. For prime `q` the last condition says (Euler) that `n` is a
non-residue. The list is checked by `decide +kernel`; generated by `scripts/emit_small.py`.
-/

namespace LLS

/-- One certificate. -/
def certOK (q n k : ℕ) : Bool :=
  0 < n && n < q && 2 ^ k ≤ q ^ 16 && n * 256 * 10 ^ 20 ≤ (k * 6931471803) ^ 2 &&
    n ^ ((q - 1) / 2) % q != 1

/-- Check consecutive moduli starting at `q`. -/
def checkFrom : ℕ → List (ℕ × ℕ) → Bool
  | _, [] => true
  | q, e :: t => certOK q e.1 e.2 && checkFrom (q + 1) t

