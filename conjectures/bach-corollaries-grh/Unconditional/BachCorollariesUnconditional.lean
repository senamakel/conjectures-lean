import Main      -- leanprover-community/riemann-hypothesis: `LFunction_ne_zero_of_half_lt_re`
import BachCorollaries.GRH

/-!
# The three corollaries of Bach's bound, with GRH supplied by the riemann-hypothesis repository

Not part of the default build: it needs that project's compiled modules and lls-grh's
`LLS.Bach2.Main2`. Run `scripts/check-unconditional.sh`.
-/

namespace BachCorollaries.Unconditional

/-- `(ZMod m)ˣ` is generated by the units represented by `0 < a ≤ 2 log² m`. -/
theorem generators : GeneratorBound 2 :=
  generators_of_GRH LFunction_ne_zero_of_half_lt_re

/-- Every odd composite `n` has an Euler witness `a ≤ 2 log² n` prime to `n`. -/
theorem solovayStrassen : SolovayStrassenStatement 2 :=
  solovayStrassen_of_GRH LFunction_ne_zero_of_half_lt_re

/-- The deterministic Solovay–Strassen test is correct for every odd `n > 1`. -/
theorem solovayStrassenTest_iff_prime {n : ℕ} (hn : Odd n) (h1 : 1 < n) :
    solovayStrassenTest n = true ↔ n.Prime :=
  solovayStrassenTest_iff_prime_of_GRH LFunction_ne_zero_of_half_lt_re hn h1

/-- Miller's reduction: a multiple of `λ(n)` lets a base `a ≤ 2 log² n` split `n`. -/
theorem millerFactoring : MillerFactoringStatement 2 :=
  millerFactoring_of_GRH LFunction_ne_zero_of_half_lt_re

end BachCorollaries.Unconditional

#print axioms BachCorollaries.Unconditional.generators
#print axioms BachCorollaries.Unconditional.solovayStrassen
#print axioms BachCorollaries.Unconditional.solovayStrassenTest_iff_prime
#print axioms BachCorollaries.Unconditional.millerFactoring
