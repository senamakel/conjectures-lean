import BachCorollaries
import LLS.Bach2.Main2

/-!
# The three corollaries under GRH, with Bach's constant `2`

`LLS.bach2_of_GRH : Ankeny.BachSubgroupBound 2` (lls-grh, `LLS/Bach2/Main2.lean`, valid for every
modulus `q ≥ 1`) supplies the hypothesis of the main library.

Not part of the default build: importing `LLS.Bach2.Main2` builds lls-grh's proved-sound
`native_decide` checker (15 chunks, about 1342 CPU-seconds). `scripts/check-unconditional.sh`
builds it.
-/

namespace BachCorollaries

open Erdos985 (DirichletLNonvanishingRightOfHalf)

/-- Under GRH, `(ZMod m)ˣ` is generated by the units represented by `0 < a ≤ 2 log² m`. -/
theorem generators_of_GRH (hGRH : DirichletLNonvanishingRightOfHalf) : GeneratorBound 2 :=
  generators_of_bach (LLS.bach2_of_GRH hGRH)

/-- Under GRH, every odd composite `n` has an Euler witness `a ≤ 2 log² n` prime to `n`. -/
theorem solovayStrassen_of_GRH (hGRH : DirichletLNonvanishingRightOfHalf) :
    SolovayStrassenStatement 2 :=
  solovayStrassen_of_bach (LLS.bach2_of_GRH hGRH)

/-- Under GRH, the deterministic Solovay–Strassen test is correct for every odd `n > 1`. -/
theorem solovayStrassenTest_iff_prime_of_GRH (hGRH : DirichletLNonvanishingRightOfHalf)
    {n : ℕ} (hn : Odd n) (h1 : 1 < n) : solovayStrassenTest n = true ↔ n.Prime :=
  solovayStrassenTest_iff_prime (LLS.bach2_of_GRH hGRH) hn h1

/-- Under GRH, a multiple of `λ(n)` lets a base `a ≤ 2 log² n` split `n` (Miller). -/
theorem millerFactoring_of_GRH (hGRH : DirichletLNonvanishingRightOfHalf) :
    MillerFactoringStatement 2 :=
  millerFactoring_of_bach (LLS.bach2_of_GRH hGRH)

end BachCorollaries
