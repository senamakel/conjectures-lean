import Ankeny.Statement

/-!
# Three corollaries of Bach's subgroup bound (target statements — do not change the definitions)

Bach, *Explicit bounds for primality testing and related problems*, Math. Comp. 55 (1990)
355–380. Under ERH:

* Theorem 2: a proper subgroup of `(ℤ/m)ˣ` omits a positive integer `< 2 log² m`;
* Theorem 3: it omits a positive integer `< 3 log² m` that is prime to `m`;
* §6, after Theorem 3: "a composite number `m` has a witness for its compositeness (in the
  sense of Miller or Solovay–Strassen) that is at most `2 log² m`", and "`(ℤ/m)ˣ` is generated
  by the numbers less than `3 log² m` that are relatively prime to `m`".

`Ankeny.BachSubgroupBound c` (ankeny-grh) returns a **unit** outside the subgroup, so it is
Theorem 3 with constant `c`; lls-grh proves it with `c = 2`. The statements below are the three
consequences, with the constant as a parameter:

* `GeneratorBound c`: `(ℤ/m)ˣ` is generated by the classes of the positive integers
  `≤ c log² m` that are units mod `m` (Bach's §6 statement has `3`);
* `SolovayStrassenStatement c`: every odd composite `n` has a base `a ≤ c log² n`, prime to `n`,
  for which Euler's criterion `a^((n-1)/2) ≡ (a/n)` fails (Jacobi symbol). Solovay–Strassen,
  *A fast Monte-Carlo test for primality*, SIAM J. Comput. 6 (1977) 84–85, for the test;
  Bach (1990) for the constant `2`;
* `MillerFactoringStatement c`: given any `M > 0` killing `(ℤ/n)ˣ` (a multiple of Carmichael's
  `λ(n)`, for instance `φ(n)`), an odd `n` that is not a prime power is split by
  `gcd(a^(2^i t) - 1, n)` for some base `a ≤ c log² n` and some `i ≤ s`, where `M = 2^s t`
  with `t` odd. Miller, *Riemann's hypothesis and tests for primality*, J. Comput. System Sci.
  13 (1976) 300–317 (deterministic reduction of factoring to computing `φ(n)` or `λ(n)` under
  ERH; theorem numbering not re-read).
-/

namespace BachCorollaries

/-- `(ZMod m)ˣ` is generated by the units represented by positive integers `a ≤ c log² m`. -/
def GeneratorBound (c : ℝ) : Prop :=
  ∀ (m : ℕ) [NeZero m],
    Subgroup.closure {u : (ZMod m)ˣ |
      ∃ a : ℕ, 0 < a ∧ (a : ℝ) ≤ c * Real.log m ^ 2 ∧ (u : ZMod m) = a} = ⊤

/-- `n` is an Euler probable prime to base `a`: `a^((n-1)/2) ≡ (a/n) (mod n)`, with the
Jacobi symbol `(a/n)`. -/
def IsEulerProbablePrime (n a : ℕ) : Prop :=
  (a : ZMod n) ^ ((n - 1) / 2) = ((jacobiSym a n : ℤ) : ZMod n)

/-- Every odd composite `n` has an Euler witness `a ≤ c log² n` prime to `n`. -/
def SolovayStrassenStatement (c : ℝ) : Prop :=
  ∀ n : ℕ, Odd n → 1 < n → ¬ n.Prime →
    ∃ a : ℕ, 0 < a ∧ (a : ℝ) ≤ c * Real.log n ^ 2 ∧ a.Coprime n ∧ ¬ IsEulerProbablePrime n a

/-- Miller's factoring: for odd `n > 1` that is not a prime power and any `M > 0` with
`u^M = 1` for every unit `u` mod `n`, write `M = 2^s t` with `t` odd; some base `a ≤ c log² n`
and some `i ≤ s` give a proper factor `gcd(a^(2^i t) - 1, n)` of `n`. -/
def MillerFactoringStatement (c : ℝ) : Prop :=
  ∀ n M : ℕ, Odd n → 1 < n → ¬ IsPrimePow n → 0 < M → (∀ u : (ZMod n)ˣ, u ^ M = 1) →
    ∃ a : ℕ, 0 < a ∧ (a : ℝ) ≤ c * Real.log n ^ 2 ∧
      ∃ i ≤ M.factorization 2,
        1 < Nat.gcd (a ^ (2 ^ i * (M / 2 ^ M.factorization 2)) - 1) n ∧
        Nat.gcd (a ^ (2 ^ i * (M / 2 ^ M.factorization 2)) - 1) n < n

end BachCorollaries
