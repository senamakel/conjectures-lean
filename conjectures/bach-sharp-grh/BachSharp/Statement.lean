import Ankeny.Statement
import BachCorollaries.Statement

/-!
# Bach's sharp generator constant `2 / log² 3` (statements)

Bach, *Explicit bounds for primality testing and related problems*, Math. Comp. 55 (1990)
355–380, proves under GRH that every proper subgroup of `(ℤ/m)ˣ` misses a unit `≤ 2 log² m`
(and, in the prime-to-`m` form his §6 uses for generators, the constant `3`). He reports that
his computations allow `2 / log² 3 ≈ 1.6571` in place of `2` in one of his theorems, that this is
best possible, and that the same might hold for the generator form, which he did not check
(quoted through the 2026-11-26 novelty audit; the paper itself was not opened here).

The target of this project is that statement for every modulus:

* `sharpConst = 2 / log² 3`;
* `SharpSubgroupBound`: every proper subgroup of `(ZMod m)ˣ` misses a unit of residue
  `≤ sharpConst · log² m` (`Ankeny.BachSubgroupBound`, word for word);
* `SharpGeneratorBound`: `(ZMod m)ˣ` is generated by the classes of the positive integers
  `≤ sharpConst · log² m` (`BachCorollaries.GeneratorBound`, word for word);
* `SharpOptimal`: no smaller constant works (`m = 3`).

These definitions are fixed; the proofs live in the other modules.
-/

namespace BachSharp

/-- Bach's sharp constant `2 / log² 3 = 1.65707…`. -/
noncomputable def sharpConst : ℝ := 2 / Real.log 3 ^ 2

/-- **Target (subgroup form).** Every proper subgroup of `(ZMod m)ˣ` misses a unit of residue
`≤ (2 / log² 3) log² m`. -/
def SharpSubgroupBound : Prop := Ankeny.BachSubgroupBound sharpConst

/-- **Target (generator form).** `(ZMod m)ˣ` is generated by the classes of the positive
integers `≤ (2 / log² 3) log² m`. -/
def SharpGeneratorBound : Prop := BachCorollaries.GeneratorBound sharpConst

/-- **Optimality.** For every `c < 2 / log² 3` the subgroup bound with constant `c` fails, and so
does the generator bound. -/
def SharpOptimal : Prop :=
  ∀ c : ℝ, c < sharpConst → ¬ Ankeny.BachSubgroupBound c ∧ ¬ BachCorollaries.GeneratorBound c

end BachSharp
