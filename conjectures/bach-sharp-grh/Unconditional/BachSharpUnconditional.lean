import Main      -- leanprover-community/riemann-hypothesis: `LFunction_ne_zero_of_half_lt_re`
import BachSharp

/-!
# Bach's sharp constant outside the gap, with GRH supplied by the riemann-hypothesis repository

Not part of the default build: it needs that project's compiled modules. Run
`scripts/check-unconditional.sh`.
-/

namespace BachSharp.Unconditional

/-- Every proper subgroup of `(ZMod q)ˣ` misses a unit `≤ (2 / log² 3) log² q`, for every
`q < 2^17` or `q ≥ 5 · 2^49`. -/
theorem sharp_outside_gap (q : ℕ) [NeZero q] (hq : q < 2 ^ 17 ∨ 5 * 2 ^ 49 ≤ q)
    (H : Subgroup (ZMod q)ˣ) (hH : H ≠ ⊤) :
    ∃ a : (ZMod q)ˣ, a ∉ H ∧ ((a : ZMod q).val : ℝ) ≤ sharpConst * Real.log q ^ 2 :=
  sharp_outside_gap_of_GRH LFunction_ne_zero_of_half_lt_re q hq H hH

/-- `(ZMod m)ˣ` is generated by the positive integers `≤ (2 / log² 3) log² m`, for every
`m < 2^17` or `m ≥ 5 · 2^49`. -/
theorem generators_outside_gap (m : ℕ) [NeZero m] (hm : m < 2 ^ 17 ∨ 5 * 2 ^ 49 ≤ m) :
    Subgroup.closure {u : (ZMod m)ˣ |
      ∃ a : ℕ, 0 < a ∧ (a : ℝ) ≤ sharpConst * Real.log m ^ 2 ∧ (u : ZMod m) = a} = ⊤ :=
  generators_outside_gap_of_GRH LFunction_ne_zero_of_half_lt_re m hm

/-- The sharp bound on the gap `2^17 ≤ m < 5 · 2^49` is all that is missing. -/
theorem sharp_of_gap (hgap : SharpGap) : SharpSubgroupBound ∧ SharpGeneratorBound :=
  sharp_of_GRH_of_gap LFunction_ne_zero_of_half_lt_re hgap

end BachSharp.Unconditional

#print axioms BachSharp.Unconditional.sharp_outside_gap
#print axioms BachSharp.Unconditional.generators_outside_gap
#print axioms BachSharp.Unconditional.sharp_of_gap
