import LLSCheck

/-!
# Executable checkers for Bach's sharp constant (core Lean only)

Two checkers, both untrusted: `BachSharp/Sound.lean` and `BachSharp/Small.lean` prove them sound.

* `checkChunkC cn cd m w lo hi`: lls-grh's block checker `LLS.Check.checkChunk` with the
  constant `2` replaced by `cn/cd`. For each block `[a, b)` it takes `x = ⌊(cn/cd) La²⌋` with
  `La ≤ log a`, and tries the GRH budget uniform in `q`, then each `q` with its own prime
  factors, then ankeny-grh's generation search `Ankeny.Checker.checkGen`.
* `checkSmall lo n`: for every `lo ≤ q < lo + n`, the units of residue `≤ ySmall q` generate
  `(ZMod q)ˣ` (generation search), where `ySmall q = ⌊1.657 (logLo q 64)²⌋ ≤ 1.657 log² q`.
-/

namespace BachSharp.Check

open LLS.Check

/-- The data of a block `[a, b)` for the constant `cn/cd`. -/
def mkBDC (cn cd m a b : Nat) : BD :=
  let La := logLo a m
  let x := ((cn : Rat) * La * La / (cd : Rat)).floor.toNat
  let r := Nat.sqrt (x * 4 ^ 20)
  let l1 := logLo x MP
  { x, s1 := (r : Rat) / (2 ^ 20 : Nat), s2 := ((r + 1 : Nat) : Rat) / (2 ^ 20 : Nat), l1,
    l2 := logHi x MP, La, Lb := logHi b m, Pc := if x < NP then cesLo x else l1 - 2 }

def blockOKC (cn cd m a b : Nat) : Bool :=
  let d := mkBDC cn cd m a b
  decide (0 ≤ d.La) && decide ((d.x : Rat) ≤ (cn : Rat) * d.La * d.La / (cd : Rat)) &&
  (if d.x < 64 then allQ (fun q => Ankeny.Checker.checkGen q d.x) a (b - a)
   else sideOK d && (unifOK d ||
     (decide (d.x < NP) && wListOK d &&
       let Bn := (Bq d * (SC : Rat)).floor.toNat
       decide ((Bn : Rat) / (SC : Rat) ≤ Bq d) &&
       let wl := wList d
       allQ (fun q => decide (sumDiv q wl 0 < Bn) || Ankeny.Checker.checkGen q d.x) a (b - a))))

/-- Blocks `[a, a + max 1 ⌊a/2^w⌋)` up to `hi`. -/
def goC (cn cd m w hi : Nat) : Nat → Nat → Bool
  | 0, _ => false
  | fuel + 1, a =>
    if hi ≤ a then true
    else
      let b := min hi (a + max 1 (a >>> w))
      blockOKC cn cd m a b && goC cn cd m w hi fuel b

/-- The check for `lo ≤ q < hi` (`3 ≤ lo`) with constant `cn/cd`. -/
def checkChunkC (cn cd m w lo hi : Nat) : Bool :=
  decide (3 ≤ lo) && decide (1 ≤ m) && decide (0 < cd) && goC cn cd m w hi (hi - lo) lo

/-! ### The small moduli, without GRH -/

/-- `⌊1.657 (logLo q 64)²⌋`. -/
def ySmall (q : Nat) : Nat := ((1657 : Rat) / 1000 * logLo q 64 * logLo q 64).floor.toNat

/-- Every `lo ≤ q < lo + n` is generated by its units of residue `≤ ySmall q`. -/
def checkSmall (lo n : Nat) : Bool :=
  (List.range' lo n).all fun q =>
    decide ((ySmall q : Rat) ≤ (1657 : Rat) / 1000 * logLo q 64 * logLo q 64) &&
      Ankeny.Checker.checkGen q (ySmall q)

end BachSharp.Check
