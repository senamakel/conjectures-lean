import Mathlib

/-!
# Hironaka's resolution of singularities in characteristic 0: the statements

`HasResolution` and `HironakaStatement` are the definition `AlgebraicGeometry.Scheme.HasResolution`
and the theorem statement `resolution_of_singularities_of_charZero` of
`FormalConjectures/Wikipedia/ResolutionOfSingularities.lean` in
<https://github.com/google-deepmind/formal-conjectures> (Apache-2.0), copied word for word apart
from the namespace.

`SmoothModification` is the input this library does not prove. It is the part of Hironaka's
theorem that the rest is glue around, stated on Mathlib objects only.

Do not edit this file to make a proof go through.
-/

open CategoryTheory AlgebraicGeometry

universe u

namespace Hironaka

/--
A scheme `X` over a base `S` with structure morphism `sX : X ⟶ S` admits a *resolution of
singularities* if there is an integral scheme `Y`, smooth over `S`, together with a proper
morphism `f : Y ⟶ X` that is birational over `X`, i.e. that restricts to an isomorphism between
dense open subschemes of `Y` and of `X`.
-/
def HasResolution {S X : Scheme.{u}} (sX : X ⟶ S) : Prop :=
  ∃ (Y : Scheme.{u}) (f : Y ⟶ X),
    IsIntegral Y ∧ IsProper f ∧ Smooth (f ≫ sX) ∧ Scheme.BirationalOver f (𝟙 X)

/--
**Hironaka's theorem.** Every integral scheme that is separated and of finite type over a field
of characteristic zero admits a resolution of singularities.
-/
def HironakaStatement : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [LocallyOfFiniteType sX]
    [QuasiCompact sX] [IsSeparated sX],
    HasResolution sX

/--
The input: every reduced scheme of finite type over a field of characteristic 0 has a proper
morphism from a scheme smooth over the field that is an isomorphism over the smooth locus, with
the preimage of the smooth locus dense. This is the first four clauses of
`FunctorialResolution.IsResolutionRuleCharZero` in leanprover-community/riemann-hypothesis, with
the blowup tower forgotten.
-/
def SmoothModification : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (X : Scheme.{u}) (f : X ⟶ Spec (CommRingCat.of k))
    [LocallyOfFiniteType f] [QuasiCompact f] [IsReduced X],
    ∃ (Y : Scheme.{u}) (π : Y ⟶ X),
      Smooth (π ≫ f) ∧ IsProper π ∧ IsIso (morphismRestrict π f.smoothLocus) ∧
        Dense (π.base ⁻¹' (f.smoothLocus : Set X))

end Hironaka
